{
    "name": "tally-simple-json",
    "version": "1.16.4",
    "description": "A small, typed JavaScript client and CLI for querying Tally through TDL definitions.",
    "homepage": "https://github.com/keshavsoft/tally-simple-json#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/keshavsoft/tally-simple-json.git"
    },
    "bugs": {
        "url": "https://github.com/keshavsoft/tally-simple-json/issues"
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "import": "./src/index.js",
            "default": "./src/index.js"
        },
        "./package.json": "./package.json"
    },
    "bin": {
        "tally-simple-json": "./bin/tally-simple-json.js"
    },
    "main": "./src/index.js",
    "types": "./src/index.d.ts",
    "files": [
        "bin",
        "src",
        "docs",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "scripts": {
        "generate:dts": "create-intellisense",
        "test": "node --test test/test.js test/units.js",
        "verify": "npm run generate:dts && npm test",
        "prepack": "npm run verify",
        "prepublishOnly": "npm run verify"
    },
    "keywords": [
        "tally",
        "tdl",
        "api",
        "accounting"
    ],
    "license": "MIT",
    "engines": {
        "node": ">=20.10"
    },
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "create-intellisense": "^1.2.1"
    },
    "dependencies": {
        "@keshavsoft/api-tree": "^11.1.1",
        "fast-xml-parser": "^5.11.2",
        "tally-spec": "^1.0.0",
        "tally-xml-tdl": "^1.27.1"
    }
}